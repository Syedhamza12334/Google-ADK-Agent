# ---------------------------------------------------------
# Environment template for this agent.
#
# Copy it to a local .env before running `adk web`:
#   PowerShell : Copy-Item .env.example .env
#   Bash       : cp .env.example .env
#
# .env and .env.local are gitignored. Never commit real keys.
# ---------------------------------------------------------

# Use the Gemini Developer API (API key) rather than Vertex AI.
# Set to TRUE only if you authenticate through Google Cloud Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Gemini API key -> https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Tavily search API key -> https://app.tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key-here
